    /**
     * Register default voice command handlers
     */
    private void registerDefaultCommands() {
        // Add to cart command
        registerCommand("ADD_TO_CART", (command, params) -> {
            String productName = params.getOrDefault("product", "");
            if (!productName.isEmpty()) {
                return getLocalizedResponse("PRODUCT_ADDED", currentLanguage, productName);
            }
            return getLocalizedResponse("SPECIFY_PRODUCT", currentLanguage);
        });

        // Remove from cart command
        registerCommand("REMOVE_FROM_CART", (command, params) -> {
            String productName = params.getOrDefault("product", "");
            if (!productName.isEmpty()) {
                return getLocalizedResponse("PRODUCT_REMOVED", currentLanguage, productName);
            }
            return getLocalizedResponse("SPECIFY_PRODUCT_REMOVE", currentLanguage);
        });

        // Checkout command
        registerCommand("CHECKOUT", (command, params) -> {
            return getLocalizedResponse("CHECKOUT_INITIATED", currentLanguage);
        });

        // Show products command
        registerCommand("SHOW_PRODUCTS", (command, params) -> {
            return getLocalizedResponse("PRODUCTS_DISPLAYED", currentLanguage);
        });

        // Search command
        registerCommand("SEARCH_PRODUCTS", (command, params) -> {
            String query = params.getOrDefault("query", "");
            if (!query.isEmpty()) {
                return getLocalizedResponse("SEARCH_RESULTS", currentLanguage, query);
            }
            return getLocalizedResponse("SEARCH_QUERY_NEEDED", currentLanguage);
        });

        // View cart command
        registerCommand("VIEW_CART", (command, params) -> {
            return getLocalizedResponse("CART_DISPLAYED", currentLanguage);
        });

        // Clear cart command
        registerCommand("CLEAR_CART", (command, params) -> {
            return getLocalizedResponse("CART_CLEARED", currentLanguage);
        });

        // Help command
        registerCommand("HELP", (command, params) -> {
            return getLocalizedResponse("HELP_MESSAGE", currentLanguage);
        });

        // Stop listening command
        registerCommand("STOP_LISTENING", (command, params) -> {
            stopListening();
            return getLocalizedResponse("VOICE_STOPPED", currentLanguage);
        });

        // Start listening command
        registerCommand("START_LISTENING", (command, params) -> {
            startListening();
            return getLocalizedResponse("VOICE_STARTED", currentLanguage);
        });
    }

