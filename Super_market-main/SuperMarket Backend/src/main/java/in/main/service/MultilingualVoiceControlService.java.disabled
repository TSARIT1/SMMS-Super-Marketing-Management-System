    /**
     * Start voice recognition
     */
    public boolean startListening() {
        try {
            if (recognizer != null && !isListening) {
                recognizer.requestFocus();
                recognizer.resume();
                isListening = true;
                return true;
            }
        } catch (Exception e) {
            System.err.println("Failed to start voice listening: " + e.getMessage());
        }
        return false;
    }

    /**
     * Stop voice recognition
     */
    public boolean stopListening() {
        try {
            if (recognizer != null && isListening) {
                recognizer.pause();
                isListening = false;
                return true;
            }
        } catch (Exception e) {
            System.err.println("Failed to stop voice listening: " + e.getMessage());
        }
        return false;
    }

    /**
     * Process voice command
     */
    public String processVoiceCommand(String spokenText) {
        if (spokenText == null || spokenText.trim().isEmpty()) {
            return getLocalizedResponse("NO_COMMAND", currentLanguage);
        }

        String command = spokenText.toLowerCase().trim();
        Map<String, String> params = extractParameters(command);

        // Find matching command in current language
        for (Map.Entry<String, Map<String, String>> entry : COMMAND_TRANSLATIONS.entrySet()) {
            String commandId = entry.getKey();
            String localizedCommand = entry.getValue().getOrDefault(currentLanguage, entry.getValue().get("en-US"));

            if (command.contains(localizedCommand.toLowerCase())) {
                VoiceCommandHandler handler = commandHandlers.get(commandId);
                if (handler != null) {
                    return handler.handle(commandId, params);
                }
                break;
            }
        }

        return getLocalizedResponse("COMMAND_NOT_RECOGNIZED", currentLanguage, spokenText);
    }

    /**
     * Set current language for voice recognition
     */
    public boolean setLanguage(String languageCode) {
        if (SUPPORTED_LANGUAGES.containsKey(languageCode)) {
            currentLanguage = languageCode;
            updateRecognizerForLanguage(languageCode);
            return true;
        }
        return false;
    }

    /**
     * Get current language
     */
    public String getCurrentLanguage() {
        return currentLanguage;
    }

    /**
     * Get supported languages
     */
    public Map<String, String> getSupportedLanguages() {
        return new HashMap<>(SUPPORTED_LANGUAGES);
    }

    /**
     * Register a custom voice command handler
     */
    public void registerCommand(String commandId, VoiceCommandHandler handler) {
        commandHandlers.put(commandId, handler);
    }

    /**
     * Simulate voice command for testing (fallback when speech recognition not available)
     */
    public String simulateVoiceCommand(String command) {
        return processVoiceCommand(command);
    }

    /**
     * Get available voice commands for current language
     */
    public List<String> getAvailableCommands() {
        return COMMAND_TRANSLATIONS.keySet().stream()
            .map(commandId -> COMMAND_TRANSLATIONS.get(commandId).getOrDefault(currentLanguage,
                COMMAND_TRANSLATIONS.get(commandId).get("en-US")))
            .collect(java.util.stream.Collectors.toList());
    }

    /**
     * Check if voice recognition is available
     */
    public boolean isVoiceRecognitionAvailable() {
        return recognizer != null;
    }

    /**
     * Get voice recognition status
     */
    public Map<String, Object> getVoiceStatus() {
        Map<String, Object> status = new HashMap<>();
        status.put("isListening", isListening);
        status.put("isAvailable", isVoiceRecognitionAvailable());
        status.put("currentLanguage", currentLanguage);
        status.put("languageName", SUPPORTED_LANGUAGES.get(currentLanguage));
        status.put("availableCommands", getAvailableCommands());
        status.put("supportedLanguages", getSupportedLanguages());
        return status;
    }

    /**
     * Extract parameters from voice command
     */
    private Map<String, String> extractParameters(String command) {
        Map<String, String> params = new HashMap<>();

        // Extract product names (multilingual)
        String[] productKeywords = getProductKeywordsForLanguage(currentLanguage);
        for (String product : productKeywords) {
            if (command.contains(product.toLowerCase())) {
                params.put("product", product);
                break;
            }
        }

        // Extract search queries
        String searchKeyword = COMMAND_TRANSLATIONS.get("SEARCH_PRODUCTS").getOrDefault(currentLanguage, "search for");
        if (command.contains(searchKeyword.toLowerCase())) {
            String query = command.substring(command.indexOf(searchKeyword.toLowerCase()) + searchKeyword.length()).trim();
            params.put("query", query);
        }

        return params;
    }

    /**
     * Get product keywords for specific language
     */
    private String[] getProductKeywordsForLanguage(String languageCode) {
        Map<String, String[]> productKeywords = Map.of(
            "hi-IN", new String[]{"दूध", "रोटी", "केला", "आलू", "टमाटर", "प्याज", "चावल", "गेहूं", "दाल", "चीनी"},
            "bn-IN", new String[]{"দুধ", "রুটি", "কলা", "আলু", "টমেটো", "পেঁয়াজ", "চাল", "গম", "ডাল", "চিনি"},
            "te-IN", new String[]{"పాలు", "రొట్టె", "అరటిపండు", "బంగాళాదుంప", "టొమాటో", "ఉల్లిపాయ", "వరిగా", "గోధుమలు", "కంది", "చక్కెర"},
            "mr-IN", new String[]{"दूध", "भाकर", "केळी", "बटाटा", "टोमॅटो", "कांदा", "तांदूळ", "गहू", "डाळ", "साखर"},
            "ta-IN", new String[]{"பால்", "ரொட்டி", "வாழைப்பழம்", "உருளைக்கிழங்கு", "தக்காளி", "வெங்காயம்", "அரிசி", "கோதுமை", "பருப்பு", "சர்க்கரை"},
            "es-ES", new String[]{"leche", "pan", "plátano", "patata", "tomate", "cebolla", "arroz", "trigo", "lentejas", "azúcar"},
            "fr-FR", new String[]{"lait", "pain", "banane", "pomme de terre", "tomate", "oignon", "riz", "blé", "lentilles", "sucre"},
            "de-DE", new String[]{"milch", "brot", "banane", "kartoffel", "tomate", "zwiebel", "reis", "weizen", "linsen", "zucker"},
            "zh-CN", new String[]{"牛奶", "面包", "香蕉", "土豆", "西红柿", "洋葱", "大米", "小麦", "扁豆", "糖"},
            "ar-SA", new String[]{"حليب", "خبز", "موز", "بطاطس", "طماطم", "بصل", "أرز", "قمح", "عدس", "سكر"}
        );

        return productKeywords.getOrDefault(languageCode, new String[]{"milk", "bread", "banana", "potato", "tomato", "onion", "rice", "wheat", "lentils", "sugar"});
    }


    /**
     * Simple functional interface for voice command handlers
     */
    private interface VoiceCommandHandler {
        String handle(String commandId, Map<String, String> params);
    }

}

