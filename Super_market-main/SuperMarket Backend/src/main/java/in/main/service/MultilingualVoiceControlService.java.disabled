    public MultilingualVoiceControlService() {
        initializeLanguageSupport();
        initializeVoiceRecognition();
        registerDefaultCommands();
    }

    /**
     * Initialize language support and translations
     */
    private void initializeLanguageSupport() {
        languageNames.putAll(SUPPORTED_LANGUAGES);
        multilingualCommands.putAll(COMMAND_TRANSLATIONS);
    }

    /**
     * Initialize voice recognition engine with multilingual support
     */
    private void initializeVoiceRecognition() {
        try {
            // Set up speech recognition with multilingual support
            System.setProperty("freetts.voices", "com.sun.speech.freetts.en.us.cmu_us_kal.KevinVoiceDirectory");

            // Create a Recognizer with current language
            updateRecognizerForLanguage(currentLanguage);

        } catch (Exception e) {
            System.err.println("Failed to initialize multilingual voice recognition: " + e.getMessage());
            // Fallback to text-based simulation
        }
    }

    /**
     * Update recognizer for specific language
     */
    private void updateRecognizerForLanguage(String languageCode) {
        try {
            // Close existing recognizer
            if (recognizer != null) {
                stopListening();
                recognizer.deallocate();
            }

            // Create new recognizer for the language
            Locale locale = getLocaleFromLanguageCode(languageCode);
            recognizer = Central.createRecognizer(new EngineModeDesc(locale));

            if (recognizer != null) {
                recognizer.allocate();

                // Create grammar for current language
                RuleGrammar grammar = recognizer.newRuleGrammar("commands");
                StringBuilder rules = new StringBuilder();

                // Build grammar rules for current language
                Map<String, String> currentLangCommands = COMMAND_TRANSLATIONS.entrySet().stream()
                    .collect(HashMap::new,
                             (map, entry) -> map.put(entry.getKey(), entry.getValue().getOrDefault(languageCode, entry.getValue().get("en-US"))),
                             HashMap::putAll);

                for (Map.Entry<String, String> entry : currentLangCommands.entrySet()) {
                    rules.append("<").append(entry.getKey().toLowerCase()).append("> = ").append(entry.getValue()).append(";\n");
                }

                // Add product name recognition (multilingual)
                rules.append("<product> = ").append(getProductNamesForLanguage(languageCode)).append(";\n");
                rules.append("<command> = ");
                COMMAND_TRANSLATIONS.keySet().forEach(key -> rules.append("<").append(key.toLowerCase()).append("> | "));
                rules.setLength(rules.length() - 3); // Remove last " | "
                rules.append(";\n");

                grammar.setRule("commands", grammar.ruleForJSGF(rules.toString()), true);
                recognizer.addGrammar(grammar);

                // Add result listener
                recognizer.addResultListener(new ResultAdapter() {
                    @Override
                    public void resultAccepted(ResultEvent e) {
                        Result result = (Result) e.getSource();
                        String command = result.getBestToken(0).getSpokenText();
                        processVoiceCommand(command);
                    }
                });
            }

        } catch (Exception e) {
            System.err.println("Failed to update recognizer for language " + languageCode + ": " + e.getMessage());
        }
    }

    /**
     * Get locale from language code
     */
    private Locale getLocaleFromLanguageCode(String languageCode) {
        String[] parts = languageCode.split("-");
        if (parts.length == 2) {
            return new Locale(parts[0], parts[1]);
        }
        return new Locale(parts[0]);
    }

