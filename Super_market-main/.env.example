# ============================================
# SUPERMARKET APPLICATION ENVIRONMENT CONFIGURATION
# ============================================
# 
# IMPORTANT: Copy this file to .env and update all values
# DO NOT commit .env file to version control
#
# Usage:
# 1. Copy: cp .env.example .env
# 2. Edit: Update all values marked with CHANGE THIS
# 3. Run: docker-compose up -d
#
# ============================================

# ============================================
# APPLICATION ENVIRONMENT
# ============================================
SPRING_PROFILES_ACTIVE=prod

# ============================================
# DATABASE CONFIGURATION (MySQL)
# ============================================
MYSQL_DATABASE=supermarket
MYSQL_USER=supermarket_user
MYSQL_PASSWORD=SuperMarket@2026!User
MYSQL_ROOT_PASSWORD=SuperMarket@2026!Root
MYSQL_PORT=3307

# Connection string for Spring Boot
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/supermarket?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=supermarket_user
SPRING_DATASOURCE_PASSWORD=SuperMarket@2026!User

# ============================================
# BACKEND SERVER CONFIGURATION
# ============================================
BACKEND_PORT=8080

# ============================================
# FRONTEND SERVER CONFIGURATION
# ============================================
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080

# ============================================
# SECURITY CONFIGURATION
# ============================================
# JWT Secret (CHANGE THIS TO A SECURE VALUE!)
JWT_SECRET=tsar-supermarket-jwt-secret-key-2026-production-256bit-change-this-to-random
JWT_EXPIRATION_MS=86400000

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ============================================
# RAZORPAY PAYMENT GATEWAY (Optional)
# ============================================
# Use test keys for development
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# ============================================
# SUBSCRIPTION PRICING (in INR paise)
# ============================================
SUBSCRIPTION_TRIAL_DAYS=5
SUBSCRIPTION_BASIC_PRICE=6000
SUBSCRIPTION_STANDARD_PRICE=12000
SUBSCRIPTION_PREMIUM_PRICE=25000

# ============================================
# GENERAL CONFIGURATION
# ============================================
TZ=Asia/Kolkata
SHOW_SQL=false
LOGGING_LEVEL=INFO
