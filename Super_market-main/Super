import React, { useState, useEffect } from "react";
import { Star, Save, Edit3 } from "lucide-react";
import toast, { Toaster } from "react-hot-toast";
import api from "../utils/api";

const ProfileDiscounts = () => {
  const [profile, setProfile] = useState({
    discount_offers: "10% off on first order | 5% cashback above ₹1000",
  });
  const [isEditing, setIsEditing] = useState(false);
  const [saving, setSaving] = useState(false);

  const getAccountEmail = () => {
    try {
      const adminRaw = localStorage.getItem("admin");
      if (adminRaw) {
        const admin = JSON.parse(adminRaw);
        if (admin?.email) return admin.email;
      }
    } catch { /* ignore */ }
    try {
      const userRaw = localStorage.getItem("user");
      if (userRaw) {
        const user = JSON.parse(userRaw);
        if (user?.email) return user.email;
      }
    } catch { /* ignore */ }
    return null;
  };

  useEffect(() => {
    const fetchProfile = async () => {
      try {
        const email = getAccountEmail();
        if (!email) return;
        const resp = await api.get("/profile", { params: { email } });
        if (resp.data) {
          setProfile((prev) => ({ ...prev, ...resp.data }));
        }
      } catch (err) {
        console.error("Failed to fetch profile:", err);
      }
    };
    fetchProfile();
  }, []);

  const handleChange = (e) => {
    setProfile({ ...profile, discount_offers: e.target.value });
  };

  const handleSave = async () => {
    setSaving(true);
    try {
      const form = new FormData();
      const accountEmail = getAccountEmail();
      if (!accountEmail) {
        toast.error("Could not determine user email.");
        setSaving(false);
        return;
      }
      form.append("account_email", accountEmail);
      form.append("discount_offers", profile.discount_offers);
      await api.put("/profile", form, { headers: { "Content-Type": "multipart/form-data" } });
      toast.success("Discount offers updated!");
      setIsEditing(false);
    } catch (err) {
      console.error("Failed to save:", err);
      toast.error("Failed to save discount offers.");
    } finally {
      setSaving(false);
    }
  };

  return (
    <>
      <Toaster position="top-right" />
      <div className="card overflow-hidden fade-up">
        <div className="bg-gradient-to-r from-yellow-500 to-orange-600 p-4 sm:p-6 text-white">
          <div className="flex items-center justify-between">
            <h2 className="text-xl sm:text-2xl font-bold flex items-center gap-2">
              <Star size={24} />
              Discounts & Offers
            </h2>
            {!isEditing && (
              <button onClick={() => setIsEditing(true)} className="flex items-center gap-2 px-3 py-2 bg-white text-orange-600 rounded-lg font-medium hover:bg-gray-100 transition">
                <Edit3 size={16} /> Edit
              </button>
            )}
          </div>
        </div>
        <div className="p-4 sm:p-6">
          {isEditing ? (
            <div className="space-y-4">
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">
                  Discount Offers
                </label>
                <textarea
                  value={profile.discount_offers}
                  onChange={handleChange}
                  rows={4}
                  placeholder="Enter discount offers (e.g., 10% off on first order | 5% cashback above ₹1000)"
                  className="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500"
                />
                <p className="text-xs text-gray-500 mt-1">
                  Separate multiple offers with | symbol
                </p>
              </div>
              <div className="flex gap-3">
                <button onClick={() => setIsEditing(false)} className="px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 font-medium">
                  Cancel
                </button>
                <button onClick={handleSave} disabled={saving} className="px-4 py-2 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600 font-medium flex items-center gap-2">
                  {saving ? "Saving..." : (<><Save size={16} /> Save</>)}
                </button>
              </div>
            </div>
          ) : (
            <div className="space-y-4">
              <div className="bg-yellow-50 border border-yellow-200 rounded-lg p-6">
                <h3 className="font-semibold text-yellow-800 mb-2">Current Offers</h3>
                <p className="text-yellow-900 whitespace-pre-line">{profile.discount_offers || "No discounts configured"}</p>
              </div>
              <div className="bg-blue-50 border border-blue-200 rounded-lg p-4">
                <h4 className="font-medium text-blue-800 mb-2">Tips for Effective Offers</h4>
                <ul className="text-sm text-blue-700 list-disc list-inside space-y-1">
                  <li>Use clear percentages (e.g., 10% off)</li>
                  <li>Set minimum purchase amounts for cashback</li>
                  <li>Include seasonal promotions</li>
                  <li>Separate multiple offers with | symbol</li>
                </ul>
              </div>
            </div>
          )}
        </div>
      </div>
    </>
  );
};

export default ProfileDiscounts;
