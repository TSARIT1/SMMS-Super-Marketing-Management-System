{
  "name": "SMMS - Super Market Management System",
  "short_name": "SMMS",
  "description": "Complete Super Market Management System by TSAR IT with inventory tracking, sales analytics, and AI-powered insights",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#2563eb",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en",
  "categories": ["business", "productivity", "utilities"],
